    {
      "name": "prompt: in a two-person chat",
      "from": "core",
      "message": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "prompt",
        "params": {
          "message": "m-1",
          "text": "run the tests",
          "chat": {
            "id": "c-1",
            "group": false,
            "name": null
          },
          "sender": {
            "id": "u-1",
            "name": "Alice"
          },
          "attachments": []
        }
      }
    },
    {
      "name": "prompt: a reply in a group that chose a folder, with an attachment, resuming a session",
      "from": "core",
      "message": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "prompt",
        "params": {
          "message": "m-2",
          "text": "and this one?",
          "chat": {
            "id": "c-2",
            "group": true,
            "name": "Family",
            "folder": "/work/other"
          },
          "sender": {
            "id": "u-2",
            "name": "Bob"
          },
          "attachments": [
            {
              "path": "/work/inbox/a1/photo.png",
              "name": "photo.png",
              "media_type": "image/png"
            }
          ],
          "reply_to": {
            "message": "m-1",
            "text": "run the tests",
            "author": {
              "id": "u-1",
              "name": "Alice"
            }
          },
          "session": "s-1"
        }
      }
    },
    {
      "name": "answer: an approval",
      "from": "core",
      "message": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "answer",
        "params": {
          "request": "r-0",
          "item": "ap-2",
          "by": {
            "id": "u-1",
            "name": "Alice"
          },
          "given": {
            "choice": "once"
          }
        }
      }
    },
    {
      "name": "answer: a question item, with options chosen and text typed",
