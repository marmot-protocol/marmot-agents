    {
      "name": "hello: a coding harness, with its folder",
      "from": "connector",
      "message": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "hello",
        "params": {
          "connector": {
            "name": "marmot-agent-example",
            "version": "0.1.0"
          },
          "harness": {
            "name": "example",
            "version": "1.2.3"
          },
          "capabilities": {
            "interrupt": true,
            "mid_turn": "restart",
            "sessions": "core",
            "resume": true,
            "approvals": true,
            "files_in": "images",
            "approval_commands": []
          },
          "folder": "/work/demo",
          "protocol": "marmot.agent-control.v3",
          "token": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
        }
      }
    },
    {
      "name": "hello: a gateway, with typed commands and no folder",
      "from": "connector",
      "message": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "hello",
        "params": {
          "connector": {
            "name": "marmot-agent-gateway",
            "version": "0.1.0"
          },
          "harness": {
            "name": "gateway"
          },
          "capabilities": {
            "interrupt": true,
            "mid_turn": "queue",
            "sessions": "own",
            "resume": true,
            "approvals": true,
            "files_in": "none",
            "approval_commands": [
              {
                "command": "/approve",
                "counts": "start"
              },
              {
                "command": "/exec",
                "counts": "anywhere"
              }
            ]
          },
          "protocol": "marmot.agent-control.v3",
          "token": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
        }
      }
    },
