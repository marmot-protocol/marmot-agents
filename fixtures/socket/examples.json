    {
      "name": "event: questions wait, one of them secret",
      "from": "connector",
      "message": {
        "jsonrpc": "2.0",
        "method": "event",
        "params": {
          "item": "q-1",
          "type": "question",
          "state": "waiting",
          "title": "A question",
          "text": "Which colour? And the password?",
          "body": {
            "answer_via": "request",
            "questions": [
              {
                "id": "q0",
                "header": "Colour",
                "text": "Which colour?",
                "options": [
                  {
                    "id": "o0",
                    "label": "Red",
                    "description": "Warm"
                  },
                  {
                    "id": "o1",
                    "label": "Blue"
                  }
                ],
                "multiple": false,
                "allow_text": true
              },
              {
                "id": "q1",
                "text": "The password?",
                "options": [],
                "multiple": false,
                "allow_text": true,
                "secret": true
              }
            ]
          },
          "session": "s-1",
          "turn": "t-4",
          "chat": "c-1",
          "native": {
            "kind": "request",
            "payload": {
              "questions": 2
            }
          }
        }
      }
