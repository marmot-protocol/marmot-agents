{
  "description": "Examples of every message on the core's socket: those from the core as it writes them, those from a connector as the core reads them. Written by the test in crates/marmot-agent/src/socket/corpus.rs, which checks them; do not edit them by hand.",
  "examples": [
    {
      "name": "the welcome, in answer to a hello",
      "from": "core",
      "message": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "core": {
            "version": "0.1.0"
          },
          "agent": {
            "name": "Agent"
          }
        }
      }
    },
    {
      "name": "a hello refused: another protocol",
      "from": "core",
      "message": {
        "jsonrpc": "2.0",
