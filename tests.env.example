# The model that the scenarios against real harnesses, and the recorders in tools/record, run on (D-100).
# Copy this file to tests.env, which git ignores, and fill it in: there is no default endpoint or model.
# A variable set in the environment wins over this file. The ordinary tests use recorded sessions and
# need none of it. CI's nightly workflow sets the same names from its secrets.
#
# One NAME=value per line, without quotes, each name once; a line starting with # is a comment.

# An OpenAI-compatible endpoint.
MODEL_BASE_URL=https://models.example/v1
# The model, as the endpoint names it.
MODEL_NAME=some/model
# The file that holds the endpoint's key, readable by you alone (chmod 600), outside the repository.
# It is mounted read-only into each harness's container and never copied.
MODEL_KEY_FILE=/absolute/path/to/model.key
# OpenCode reaches models through its own providers: the model as OpenCode names it, provider/model. Its
# scenario and recorder run it with a throwaway home, so pick one it reaches without signing in.
OPENCODE_MODEL=provider/model
