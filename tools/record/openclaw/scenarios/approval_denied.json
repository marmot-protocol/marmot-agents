{
  "name": "approval_denied",
  "chats": {
    "family": {
      "name": "Family",
      "type": "group"
    }
  },
  "env": {
    "EXEC_MODE": "ask",
    "OPENCLAW_CONFIG_PATCH": "{\"approvals\":{\"exec\":{\"enabled\":true,\"mode\":\"session\"}}}"
  },
  "steps": [
    {
      "chat": "family",
      "user": "alice",
      "user_name": "Alice",
      "text": "Use your exec tool to run exactly this command and tell me the result: rm -rf /tmp/recorder-demo-dir",
      "wait": false
    },
    {
      "wait_for_text": "/approve",
      "timeout": 600
    },
    {
      "sleep": 2
    },
    {
      "chat": "family",
      "user": "alice",
      "user_name": "Alice",
      "text": "/approve {approval_id} deny",
      "wait": false
    },
    {
      "wait_turn": true
    }
  ]
}
