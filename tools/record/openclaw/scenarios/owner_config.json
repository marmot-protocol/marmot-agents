{
  "name": "owner_config",
  "chats": {
    "family": {
      "name": "Family",
      "type": "group"
    }
  },
  "env": {
    "EXEC_MODE": "ask",
    "OPENCLAW_CONFIG_PATCH": "{\"approvals\": {\"exec\": {\"enabled\": true, \"mode\": \"session\"}}, \"commands\": {\"ownerAllowFrom\": [\"recorder:alice\"], \"config\": true, \"debug\": true}}",
    "RECORDER_PLUGIN_HOOKS": "session_start,session_end,before_reset"
  },
  "steps": [
    {
      "chat": "family",
      "user": "alice",
      "user_name": "Alice",
      "text": "/whoami"
    },
    {
      "chat": "family",
      "user": "alice",
      "user_name": "Alice",
      "text": "/exec"
    },
    {
      "chat": "family",
      "user": "alice",
      "user_name": "Alice",
      "text": "/debug set tools.exec.mode=full"
    },
    {
      "chat": "family",
      "user": "alice",
      "user_name": "Alice",
      "text": "/exec"
    },
    {
      "chat": "family",
      "user": "alice",
      "user_name": "Alice",
      "text": "Use your exec tool to run exactly this command and tell me the result: rm -rf /tmp/recorder-demo-dir",
      "wait": false
    },
    {
      "wait_for_text": "/approve",
      "timeout": 150,
      "required": false
    },
    {
      "sleep": 2
    },
    {
      "chat": "family",
      "user": "alice",
      "user_name": "Alice",
      "text": "/approve {approval_id} deny",
      "wait": false
    },
    {
      "wait_turn": true
    },
    {
      "chat": "family",
      "user": "alice",
      "user_name": "Alice",
      "text": "/debug reset"
    },
    {
      "chat": "family",
      "user": "alice",
      "user_name": "Alice",
      "text": "/config set tools.exec.mode=full"
    },
    {
      "sleep": 20
    },
    {
      "chat": "family",
      "user": "alice",
      "user_name": "Alice",
      "text": "/exec"
    },
    {
      "chat": "family",
      "user": "alice",
      "user_name": "Alice",
      "text": "/activation mention"
    },
    {
      "chat": "family",
      "user": "alice",
      "user_name": "Alice",
      "text": "/send"
    }
  ]
}
