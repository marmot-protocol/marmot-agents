    {
      "chat": "family",
      "user": "alice",
      "user_name": "Alice",
      "text": "! echo recorder-demo"
    },
    {
      "chat": "family",
      "user": "alice",
      "user_name": "Alice",
      "text": "/allowlist"
    },
    {
      "chat": "family",
      "user": "alice",
      "user_name": "Alice",
      "text": "/send"
