    {
      "chat": "family",
      "user": "alice",
      "user_name": "Alice",
      "text": "/activation always"
    },
    {
      "chat": "family",
      "user": "alice",
      "user_name": "Alice",
      "text": "/mcp show"
    },
    {
      "chat": "family",
      "user": "alice",
      "user_name": "Alice",
      "text": "/plugins list"
    },
    {
      "chat": "family",
      "user": "alice",
      "user_name": "Alice",
      "text": "/acp status"
    },
    {
      "chat": "family",
      "user": "alice",
      "user_name": "Alice",
      "text": "/queue"
    }
  ]
