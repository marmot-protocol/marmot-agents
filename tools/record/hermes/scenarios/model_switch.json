{
  "name": "model_switch",
  "chats": {
    "family": {
      "name": "Family",
      "type": "group"
    }
  },
  "env": {
    "RECORDER_PLUGIN_HOOKS": "on_session_start,on_session_end,on_session_finalize,on_session_reset,on_session_open,pre_command,agent_loop_stopped,pre_approval_request,post_approval_response"
  },
  "steps": [
    {
      "chat": "family",
      "user": "alice",
      "user_name": "Alice",
      "text": "/model"
    },
    {
      "chat": "family",
      "user": "alice",
      "user_name": "Alice",
      "text": "/model z-ai/glm-5.3:free"
    },
    {
      "sleep": 2
    },
    {
      "read": "model_settings",
      "chat": "family",
      "user": "alice"
    },
    {
      "chat": "family",
      "user": "alice",
      "user_name": "Alice",
      "text": "Reply with exactly: ok"
    },
    {
      "chat": "family",
      "user": "alice",
      "user_name": "Alice",
      "text": "/status"
    },
    {
      "chat": "family",
      "user": "alice",
      "user_name": "Alice",
      "text": "/model reset"
    },
    {
      "read": "model_settings",
      "chat": "family",
      "user": "alice"
    }
  ]
}
