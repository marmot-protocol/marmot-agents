{
  "name": "marmot-agent-claude-code",
  "version": "0.1.0",
  "private": true,
  "description": "The Claude Code driver for marmot-agent: runs Claude Code and connects it to the core over the local socket",
  "license": "MIT",
  "type": "module",
  "marmot": {
    "socketProtocol": "marmot.agent-control.v3"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "check": "tsc --noEmit",
    "start": "node src/main.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.331",
    "zod": "4.6.7"
  }
}
